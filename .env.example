# EcoTrack AI - Configuración de API de IA Real
# Para activar llamadas a un modelo de IA real (Gemini, OpenAI u otro), configura la clave correspondiente aquí.
# Si dejas la clave vacía, la app funcionará automáticamente en "Modo Demo" con el motor NLP integrado.

# Opción 1: Google Gemini API (Recomendado)
VITE_AI_PROVIDER=gemini
VITE_AI_API_KEY=tu_clave_api_de_gemini_aqui

# Opción 2: OpenAI API (GPT-4o / GPT-3.5-Turbo)
# VITE_AI_PROVIDER=openai
# VITE_AI_API_KEY=tu_clave_api_de_openai_aqui
